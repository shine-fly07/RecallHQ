# ===================================================================
# RecallHQ - Environment Configuration
# Headquarters for your event memory, powered by Vectorize Hindsight & Groq
# ===================================================================

# Vectorize Hindsight API Key & Bank ID
# Get your API key at https://hindsight.vectorize.io/
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=recallhq_production_events

# Groq API Configuration
# Get your Groq API key at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
# Supported models: llama-3.3-70b-versatile, openai/gpt-oss-120b, qwen/qwen3-32b, etc.
GROQ_MODEL=llama-3.3-70b-versatile

# Optional SQLite Database Path (Defaults to local ./data/recallhq.json)
DATABASE_URL=file:./recallhq.db

